<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:layout_marginVertical="16dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/shimmerColor"
        >

        <FrameLayout
            android:id="@+id/layout_numberShimmer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="16dp"
            android:background="@color/shimmerColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            >

            <TextView
                android:id="@+id/tvMyCareerPathCourseNumber"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@color/shimmerColor"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textAlignment="center"
                android:layout_gravity="center"
                />

        </FrameLayout>

        <TextView
            android:id="@+id/tvMyCareerPathCourseTitleShimmer"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:maxLength="40"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginHorizontal="12dp"
            app:layout_constraintTop_toTopOf="@+id/layout_numberShimmer"
            app:layout_constraintStart_toEndOf="@+id/layout_numberShimmer"
            />

        <TextView
            android:id="@+id/tvMyCareerPathCourseSourceShimmer"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:maxLength="40"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvMyCareerPathCourseTitleShimmer"
            app:layout_constraintStart_toEndOf="@+id/layout_numberShimmer"
            />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="20dp"
            android:layout_marginHorizontal="20dp"
            android:weightSum="2"
            app:layout_constraintTop_toBottomOf="@+id/tvMyCareerPathCourseSourceShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            >

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:minWidth="120dp"
                android:minHeight="32dp"
                android:paddingVertical="8dp"
                android:layout_weight="1"
                app:backgroundTint="@null"
                android:layout_marginEnd="8dp"
                android:background="@color/shimmerColor"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:minHeight="32dp"
                android:paddingVertical="8dp"
                android:layout_weight="1"
                app:backgroundTint="@null"
                android:background="@color/shimmerColor"
                />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.cardview.widget.CardView>