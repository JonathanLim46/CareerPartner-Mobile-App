<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".main.profile.screen.ProfileMyCareerFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tvMyCareerGoalsTitleShimmer"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tvMyCareerGoalsShimmer"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="@color/abu"
            android:textStyle="normal"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMyCareerGoalsTitleShimmer"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tvMyCareerGoalsDescShimmer"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="@color/abu"
            android:textStyle="normal"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMyCareerGoalsShimmer"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tvMyCareerSalaryShimmer"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="@color/abu"
            android:textStyle="normal"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMyCareerGoalsDescShimmer"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tvMyCareerJobOpportunityShimmer"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="@color/abu"
            android:textStyle="normal"
            android:textSize="12sp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvMyCareerSalaryShimmer"
            app:layout_constraintStart_toStartOf="parent"
            />

        <TextView
            android:id="@+id/tvMyCareerPathCareerShimmer"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:background="@color/shimmerColor"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginTop="16sp"
            app:layout_constraintTop_toBottomOf="@+id/tvMyCareerJobOpportunityShimmer"
            app:layout_constraintStart_toStartOf="parent"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/tvMyCareerPathCareerShimmer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <include layout="@layout/each_card_profile_path_shimmer"/>

        </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>